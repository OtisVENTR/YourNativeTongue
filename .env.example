# Supabase Configuration
# Copy this file to .env and fill in your Supabase project credentials
# Get these from your Supabase project dashboard: https://app.supabase.com

# Your Supabase project URL
VITE_SUPABASE_URL=your-project-url-here

# Your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (only use on server-side, never expose in client)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
